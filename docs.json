{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Path",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#4F9779",
    "light": "#75B596",
    "dark": "#245C49"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Product",
        "pages": [
          "core-concepts/signal-mesh",
          "core-concepts/liquidity-impact"
        ]
      },
      {
        "group": "Partner Access",
        "pages": [
          "integrations/partner-access",
          "integrations/onboarding"
        ]
      },
      {
        "group": "Trust",
        "pages": [
          "compliance",
          "security",
          "contact"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "faq"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "background": {
    "color": {
      "light": "#F3F1EA",
      "dark": "#101713"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://app.pathprotocol.finance"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Contact",
      "href": "mailto:hello@pathprotocol.finance"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/pathprotocolfi"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "redirects": [
    {
      "source": "/integrations/railnet-api-audit-2026-05-15",
      "destination": "/integrations/partner-access"
    },
    {
      "source": "/integrations/integration-shape",
      "destination": "/integrations/partner-access"
    },
    {
      "source": "/integrations/api-and-widget",
      "destination": "/integrations/partner-access"
    },
    {
      "source": "/core-concepts/accuracy",
      "destination": "/core-concepts/signal-mesh"
    }
  ]
}
